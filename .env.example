# انسخ هذا الملف إلى .env واملأ قيمًا حقيقية قبل تشغيل docker compose up.
# لا تُدرج .env نفسه في Git أبدًا — فقط .env.example (بلا قيم حقيقية).

# كلمة مرور حساب sa في SQL Server داخل الحاوية.
# يجب أن تكون قوية (8+ أحرف، حروف كبيرة وصغيرة وأرقام ورمز) وإلا سيرفضها SQL Server.
DB_SA_PASSWORD=ChangeMe_StrongPassword123!

# مفتاح توقيع JWT — نص عشوائي طويل، وليس كلمة مرور يسهل تذكرها.
# يمكن توليد واحد عبر: openssl rand -base64 64
JWT_KEY=ChangeMe_GenerateA64ByteRandomKeyHere

# النطاق العام الذي سيُستخدم للوصول للنظام (مطلوب لخدمة Caddy لإصدار
# شهادة HTTPS تلقائيًا). يجب أن يشير سجل DNS (A record) لهذا النطاق إلى
# عنوان IP الخادم قبل تشغيل docker compose، وإلا فشل إصدار الشهادة.
DOMAIN=yourdomain.com

# بريد إلكتروني حقيقي يُستخدم من Let's Encrypt لإشعارات انتهاء/تجديد الشهادة.
ACME_EMAIL=you@example.com
